APP_PORT=8000
DULCE_HORA_CORS_ORIGINS=*

# Required only when exposing the local app with Cloudflare Tunnel.
# Create the tunnel in Cloudflare, route the hostname to http://dulce-hora-app:8000,
# and paste the tunnel token here before running the tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-token
